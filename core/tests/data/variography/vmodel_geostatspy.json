  "\"\"\"Reference numbers of GeostatsPy `vmodel` (MIT) for the tests of the BF2 variogram model (TZ 7.35 D-21).",
  "",
  "GeostatsPy is NOT a dependency of BF (ADR 0012): this script runs in a throw-away environment, only its output is",
  "committed (core/tests/data/variography/vmodel_geostatspy.json).",
  "",
  "    uv venv refenv --python 3.12",
  "    uv pip install --python refenv/bin/python numpy scipy pandas numba statsmodels tqdm",
  "    pip download --no-deps --no-binary :all: geostatspy==0.0.46      # unpack to <dir>",
  "    refenv/bin/python -I gen_vmodel.py <dir>/geostatspy-0.0.46 <sdist.tar.gz> <geostatspy_reference.json> out.json",
  "\"\"\"",
  "",
  "import contextlib",
  "import hashlib",
  "import io",
  "import json",
  "import math",
  "import sys",
  "",
  "import numpy as np",
  "",
  "sys.path.insert(0, sys.argv[1])",
  "import geostatspy  # noqa: E402",
  "import geostatspy.geostats as g  # noqa: E402",
  "",
  "DEG2RAD = 3.14159265 / 180.0  # as in geostatspy.geostats.vmodel: pi truncated to 9 digits",
  "",
  "",
  "def make(nug, structures):",
  "    v = {\"nug\": nug, \"nst\": len(structures)}",
  "    for i, (it, cc, azi, hmaj, hmin) in enumerate(structures, 1):",
  "        v.update({f\"it{i}\": it, f\"cc{i}\": cc, f\"azi{i}\": azi, f\"hmaj{i}\": hmaj, f\"hmin{i}\": hmin})",
  "    return v",
  "",
  "",
  "def run(vario, nlag, xlag, azm):",
  "    with contextlib.redirect_stdout(io.StringIO()):",
  "        index, h, gam, cov, ro = g.vmodel(nlag, xlag, azm, vario)",
  "    xoff, yoff = math.sin(DEG2RAD * azm) * xlag, math.cos(DEG2RAD * azm) * xlag",
  "    dx, dy, xx, yy = [], [], 0.0, 0.0",
  "    for _ in range(nlag + 1):  # the offsets exactly as vmodel accumulates them",
  "        dx.append(xx)",
  "        dy.append(yy)",
  "        xx += xoff",
  "        yy += yoff",
  "    assert [math.sqrt(max(x * x + y * y, 0.0)) for x, y in zip(dx, dy, strict=True)] == np.asarray(h).tolist()",
  "    return {",
  "        \"azm\": azm,",
  "        \"dx\": dx,",
  "        \"dy\": dy,",
  "        \"h\": np.asarray(h).tolist(),",
  "        \"gamma\": np.asarray(gam).tolist(),",
  "        \"cov\": np.asarray(cov).tolist(),",
  "    }",
  "",
  "",
  "CASES = [",
  "    # BF api/tests/test_stats_variogram.py::test_model_matches_legacy_vmodel_anisotropic",
  "    (\"bf_anisotropic\", 0.1, [(1, 0.5, 30, 40, 15), (2, 0.4, 120, 80, 50)], 10, 5.0, (0.0, 30.0, 75.0, 120.0)),",
  "    # a gaussian structure, azimuths beyond 180",
  "    (",
  "        \"gaussian_spherical\",",
  "        0.05,",
  "        [(3, 0.6, 60, 120, 40), (1, 0.35, 150, 300, 200)],",
  "        12,",
  "        20.0,",
  "        (0.0, 45.0, 60.0, 150.0, 200.0, 330.0),",
  "    ),",
  "    # one exponential structure, isotropic",
  "    (\"exponential_isotropic\", 0.0, [(2, 1.0, 0, 20, 20)], 8, 5.0, (0.0, 90.0)),",
  "]",
  "",
  "out = {",
  "    \"about\": \"GeostatsPy vmodel (MIT) - reference for bf_core.geostat.variogram.model (TZ 7.35 D-21, ADR 0012);\"",
  "    \" regenerated by the throw-away script quoted in core/tests/test_vario_model.py; see known_defects\",",
  "    \"geostatspy_version\": \"0.0.46\",",
  "    \"geostatspy_sdist_sha256\": hashlib.sha256(open(sys.argv[2], \"rb\").read()).hexdigest(),",
  "    \"numpy\": np.__version__,",
  "    \"known_defects\": [",
  "        \"geostatspy.vmodel and setup_rotmat use DEG2RAD = 3.14159265/180 (pi truncated to 9 digits): the offsets\"",
  "        \" are stored here as vmodel accumulates them (dx, dy), and the azimuth azi of a structure acts as\"",
  "        \" 90 - (90 - azi)*3.14159265/pi degrees\",",
  "        \"geostatspy.cova2 returns the sill for |h|^2 < 1e-6: the nugget jump is at |h| = 1e-3, not at 0\",",
  "    ],",
  "    \"cases\": [],",
  "}",
  "for name, nug, structures, nlag, xlag, azms in CASES:",
