  "    out[\"cases\"].append(",
  "        {",
  "            \"id\": name,",
  "            \"nug\": nug,",
  "            \"structures\": [",
  "                {\"it\": it, \"cc\": cc, \"azi\": azi, \"hmaj\": hmaj, \"hmin\": hmin} for it, cc, azi, hmaj, hmin in structures",
  "            ],",
  "            \"nlag\": nlag,",
